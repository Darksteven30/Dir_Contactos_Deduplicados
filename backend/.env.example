PORT=3000

# PostgreSQL
# Opción 1 (nube: Neon, Render, Railway): una sola cadena de conexión. Si está definida, tiene prioridad.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# Opción 2 (local con DBeaver): los datos por separado.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contactos_db
DB_USER=postgres
DB_PASSWORD=

# Autenticación
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true en producción (HTTPS). En localhost los navegadores aceptan cookies Secure.
COOKIE_SECURE=true

# Resiliencia
# Nivel de los logs: fatal, error, warn, info, debug, trace o silent
LOG_LEVEL=info
# Proxies delante de la app (1 en Render). 0 = conexión directa (desarrollo local).
TRUST_PROXY=0
# Encabezado con la IP real del usuario que pone el CDN, para el límite de intentos de login.
# En Render (detrás de Cloudflare): cf-connecting-ip. En local se deja comentado.
# CLIENT_IP_HEADER=cf-connecting-ip
# Cada cuántos minutos se borran los refresh tokens vencidos
TOKEN_CLEANUP_INTERVAL_MINUTES=60
